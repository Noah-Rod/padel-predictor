# Copy to .env and fill in real values. NEVER commit .env.
# In CI/CD the same names are provided as GitHub Actions secrets.

# --- Data source (feature pipeline) -----------------------------------------
# Which ingestion adapter to use: "sample" (offline, deterministic) or "http".
PADEL_SOURCE=sample
# Base URL of padelapi.org's REST API, used by the "http" adapter.
PADEL_API_BASE_URL=https://padelapi.org/api
# API token from https://padelapi.org/user/api-tokens (sent as a bearer token).
PADEL_API_KEY=
# "paid" (full archive + ranking history) or "free" (last six months, current
# ranking only). The free plan is enough to run the feature pipeline end to end.
PADEL_API_PLAN=paid

# --- Feature store ------------------------------------------------------------
# Production: hopsworks://<your-project-name>. A local path keeps the offline
# Parquet store, which needs no account.
PADEL_FEATURE_STORE_URI=data/feature_store
HOPSWORKS_API_KEY=
# Leave empty for the serverless app (c.app.hopsworks.ai).
HOPSWORKS_HOST=

# --- Experiment tracking & model registry -------------------------------------
# "wandb" (Weights & Biases) in production, "local" for offline runs and tests.
PADEL_TRACKING=local
WANDB_API_KEY=
WANDB_PROJECT=padel-predictor
# Your W&B user or team; empty uses the key's default entity.
WANDB_ENTITY=
# Where the local registry keeps models when PADEL_TRACKING=local.
PADEL_MODEL_REGISTRY_DIR=data/model_registry
PADEL_REGISTERED_MODEL_NAME=padel-match-winner
# Stage/alias the inference pipeline loads: the "best" model.
PADEL_MODEL_ALIAS=champion

# --- Cloud credentials (deployment) -------------------------------------------
# Path to a GCP service-account key file; keep the file itself out of git.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
# Hugging Face token, if deploying the UI to a Space.
HF_TOKEN=

# --- Serving ------------------------------------------------------------------
PADEL_API_HOST=0.0.0.0
PADEL_API_PORT=8000
PADEL_API_URL=http://localhost:8000
PADEL_LOG_LEVEL=INFO
