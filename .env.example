# Copy to .env and fill in real values. NEVER commit .env.
# In CI/CD the same names are provided as GitHub Actions secrets.

# --- Data source (feature pipeline) -----------------------------------------
# Which ingestion adapter to use: "sample" (offline, deterministic) or "http".
PADEL_SOURCE=sample
# Base URL of the live match/results endpoint used by the "http" adapter.
PADEL_API_BASE_URL=https://example.org/api/v1
# API key for the live source, if the source requires one. Leave empty if not.
PADEL_API_KEY=

# --- Feature store ------------------------------------------------------------
# Local path or object-storage URI, e.g. gs://my-bucket/padel-predictor
PADEL_FEATURE_STORE_URI=data/feature_store

# --- Experiment tracking & model registry -------------------------------------
# A local SQLite backend is the default: MLflow's file store is in maintenance mode
# and does not support the model registry. Point this at a tracking server in the cloud.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=padel-predictor
PADEL_REGISTERED_MODEL_NAME=padel-match-winner
# Stage/alias the inference pipeline loads: the "best" model.
PADEL_MODEL_ALIAS=champion

# --- Cloud credentials (deployment) -------------------------------------------
# Path to a GCP service-account key file; keep the file itself out of git.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
# Hugging Face token, if deploying the UI to a Space.
HF_TOKEN=

# --- Serving ------------------------------------------------------------------
PADEL_API_HOST=0.0.0.0
PADEL_API_PORT=8000
PADEL_API_URL=http://localhost:8000
PADEL_LOG_LEVEL=INFO
